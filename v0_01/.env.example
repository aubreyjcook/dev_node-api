# Copy this file to `.env` to change how the server starts up.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#
# `.env` is git-ignored, so your local settings never get committed.
# Node reads it because the npm scripts pass `--env-file-if-exists=.env`.

# Free-form label. Only used in the startup banner. "development" | "production" | anything.
NODE_ENV=development

# The network interface to bind to.
#   127.0.0.1  -> only reachable from this machine (the safe default while learning)
#   0.0.0.0    -> reachable from other machines on your network
HOST=127.0.0.1

# 0 asks the operating system for any free port. Useful in tests.
PORT=3000

# Value sent back in the `Access-Control-Allow-Origin` response header.
#   *                      -> any website may call this API (fine for local learning)
#   https://example.com    -> only that origin may call it
CORS_ORIGIN=*

# Largest request body we will accept, in bytes. Bodies bigger than this get a 413.
MAX_BODY_BYTES=100000

# Set to "false" to silence the per-request access log.
LOG_REQUESTS=true

# Set to "false" to start with an empty task list instead of the sample tasks.
SEED_DATA=true
